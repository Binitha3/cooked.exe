{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deadbyte.invalid/schema/rebirth-finding.schema.json",
  "title": "DEADBYTE Rebirth Detection payload",
  "type": "object",
  "required": ["schema_version", "example_kind", "findings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "example_kind": {"enum": ["fixture-derived", "synthetic"]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "trail": {"type":"object", "required":["kind","timestamp","system_id","resource_id","evidence_ids","description"], "properties":{"kind":{"type":"string"},"timestamp":{"type":"string","format":"date-time"},"system_id":{"type":"string"},"resource_id":{"type":"string"},"evidence_ids":{"type":"array","items":{"type":"string"}},"description":{"type":"string"}},"additionalProperties":false},
    "finding": {"type":"object", "required":["finding_id","status","original_system_id","original_resource_id","reappeared_system_id","reappeared_resource_id","baseline_evidence_ids","deletion_evidence_ids","later_evidence_ids","match_explanation","confidence","cause","cause_evidence_ids","affected_system_id","recommended_action","follow_up_verification","trail"], "properties":{"finding_id":{"type":"string"},"status":{"enum":["CONFIRMED_REAPPEARANCE","POSSIBLE_REAPPEARANCE","NO_REAPPEARANCE","INDETERMINATE"]},"original_system_id":{"type":["string","null"]},"original_resource_id":{"type":["string","null"]},"reappeared_system_id":{"type":["string","null"]},"reappeared_resource_id":{"type":["string","null"]},"baseline_evidence_ids":{"type":"array","items":{"type":"string"}},"deletion_evidence_ids":{"type":"array","items":{"type":"string"}},"later_evidence_ids":{"type":"array","items":{"type":"string"}},"match_explanation":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":1},"cause":{"type":["string","null"]},"cause_evidence_ids":{"type":"array","items":{"type":"string"}},"affected_system_id":{"type":["string","null"]},"recommended_action":{"type":"string"},"follow_up_verification":{"type":"string"},"trail":{"type":"array","items":{"$ref":"#/$defs/trail"}}},"additionalProperties":false}
  },
  "additionalProperties": false
}
